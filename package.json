{
  "name": "enterprise-app",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3.1.2",
    "@sap/cds": "^10",
    "@sap/xssec": "^4.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-typer": "^0.41.1",
    "@cap-js/cds-types": "^0.18.0",
    "@cap-js/sqlite": "^3.1.2",
    "@sap/cds-dk": "^10",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "watch": "cds-tsx watch",
    "watch:hybrid": "cds-tsx watch --profile hybrid",
    "typer": "cds-typer \"*\" --outputDirectory @cds-models",
    "typecheck": "tsc --noEmit",
    "lint": "biome check srv test",
    "format": "biome check --write srv test",
    "test": "vitest run",
    "build": "cds build --production",
    "bind:hybrid": "cds bind db -2 enterprise-app-db --for hybrid && cds bind auth -2 enterprise-app-auth --for hybrid && cds bind destination -2 enterprise-app-destination --for hybrid",
    "deploy": "mbt build && cf deploy mta_archives/enterprise-app_1.0.0.mtar"
  },
  "private": true,
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "hana"
      },
      "auth": {
        "kind": "xsuaa"
      },
      "[development]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "auth": {
          "kind": "mocked",
          "users": {
            "alice": {
              "roles": [
                "Employee",
                "Admin"
              ]
            },
            "bob": {
              "roles": [
                "MMUser",
                "SDUser",
                "FIUser"
              ]
            }
          }
        }
      },
      "[test]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "auth": {
          "kind": "mocked",
          "users": {
            "alice": {
              "roles": [
                "Employee",
                "Admin"
              ]
            },
            "bob": {
              "roles": [
                "MMUser",
                "SDUser",
                "FIUser"
              ]
            }
          }
        }
      }
    }
  }
}
